{
  // CRM Talk Davivienda 2.0 — un solo Worker sirve la app (apps/web) y la API (apps/api).
  // Cloudflare lo despliega solo con cada cambio en la rama main de GitHub.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-talk-davivienda",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Dirección pública https://crm-talk-davivienda.<cuenta>.workers.dev siempre activa.
  // Las vistas previas quedan apagadas: compartirían la base de datos real.
  "workers_dev": true,
  "preview_urls": false,

  // App web ya compilada. Las rutas /api/* siempre las atiende el Worker;
  // cualquier otra ruta que no sea un archivo abre la app (navegación del lado del navegador).
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Tablas: clientes, ventas, llamadas, metas, cierres y bitácora.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm-talk",
      "database_id": "f35f6b24-4e2f-45da-9a78-33ec75ecffbe",
      "migrations_dir": "packages/db/migrations"
    }
  ],

  // Archivos: Excel originales, presentaciones generadas y respaldos. Bucket privado.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "crm-talk-datos" }
  ],

  "vars": {
    "APP_ENV": "production"
    // SETUP_TOKEN (clave para crear el primer administrador) NO va aquí:
    // se define en Cloudflare → Worker → Settings → Variables and Secrets, tipo "Secret".
  },

  // Velocidad: el Worker de la API corre cerca de la base de datos (cada pantalla hace varias consultas;
  // así cada una es un viaje corto). Los archivos de la app se siguen sirviendo desde el punto más cercano al usuario.
  "placement": { "mode": "smart" },

  // Identificador de cada publicación: los resultados guardados se recalculan solos cuando cambia el código.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": { "enabled": true }
}
